OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Independent sidecar model; switch after extraction evals without touching voice.
OPENAI_LEAD_MODEL=gpt-5.3-chat-latest
OPENAI_LEAD_TIMEOUT_MS=8000
OPENAI_LEAD_MAX_OUTPUT_TOKENS=800
OPENAI_LEAD_CONCURRENCY=4
REALTIME_PLAYBACK_BUFFER_MS=80
REALTIME_LOG_DIR=logs
REALTIME_SHOW_DOMAIN_EVENTS=1
LEAD_PHONE=
ELEVATEBOX_CONTACT_NUMBER=
ELEVATEBOX_RESUME_PATH=resume.pdf
ELEVATEBOX_BUILD_IMAGE_PATH=architecture.png
# Use a stable, non-identifying hash rather than a phone number or email.
OPENAI_SAFETY_IDENTIFIER=
# Control-plane clients use this bearer token to prewarm a call.
CONTROL_API_TOKEN=
# Public TLS endpoint configured in Exotel, for example wss://voice.example.com.
PUBLIC_MEDIA_BASE_URL=
# Optional second factor supported by Exotel's WebSocket client.
MEDIA_BASIC_USERNAME=
MEDIA_BASIC_PASSWORD=
HOST=127.0.0.1
PORT=8080
