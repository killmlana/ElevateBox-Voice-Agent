# Safe default: no OpenAI, Zadarma, Asterisk, Exotel, WhatsApp, or scheduler traffic.
ELEVATEBOX_MODE=dry-run
# Primary route: Asterisk controls the Zadarma PSTN leg and OpenAI SIP leg.
# Use exotel only as the temporary rollback route.
OUTBOUND_CALL_PROVIDER=asterisk-sip
# Safe default: POST /calls/dial simulates and never contacts Asterisk or Zadarma.
SIP_DIAL_MODE=dry-run
ALLOW_PAID_SIP_CALLS=
# Legacy rollback route. These remain inert while asterisk-sip is selected.
EXOTEL_DIAL_MODE=dry-run
# Independent action adapters; both simulate unless explicitly enabled.
WHATSAPP_MODE=dry-run
# Primary provider. Set meta only to use the official Cloud API fallback.
WHATSAPP_PROVIDER=openwa
CALLBACK_MODE=dry-run
# webhook only records the booking; automatic-sip persists it and places the
# Zadarma call at the agreed time.
CALLBACK_PROVIDER=webhook
# Required only to opt into live Exotel. Keep blank on trial/non-KYC accounts.
ALLOW_PAID_EXOTEL_CALLS=
# Exact acknowledgements required only for the respective live adapter.
ALLOW_REAL_WHATSAPP_MESSAGES=
# OpenWA is unofficial. Live OpenWA requires this second exact acknowledgement:
# I_ACCEPT_OPENWA_ACCOUNT_RISK
ALLOW_UNOFFICIAL_WHATSAPP_CLIENT=
ALLOW_LIVE_CALLBACK_BOOKINGS=

OPENAI_API_KEY=
# Required only for the live Asterisk/OpenAI SIP route.
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=sage
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=512
OPENAI_REALTIME_HANDSHAKE_TIMEOUT_MS=10000
# Independent sidecar model; switch after extraction evals without touching voice.
OPENAI_LEAD_MODEL=gpt-5.4-nano
OPENAI_LEAD_TIMEOUT_MS=6000
OPENAI_LEAD_MAX_OUTPUT_TOKENS=500
OPENAI_LEAD_CONCURRENCY=4
REALTIME_PLAYBACK_BUFFER_MS=80
REALTIME_LOG_DIR=logs
REALTIME_SHOW_DOMAIN_EVENTS=1
ELEVATEBOX_TRACE_DIR=logs/live-calls
LEAD_PHONE=
ELEVATEBOX_CONTACT_NUMBER=
ELEVATEBOX_RESUME_PATH=resume.pdf
# Use a stable, non-identifying hash rather than a phone number or email.
OPENAI_SAFETY_IDENTIFIER=
# Control-plane clients use this bearer token to prewarm a call.
CONTROL_API_TOKEN=
# Exotel rollback only: public media WebSocket base, e.g. wss://voice.example.com.
PUBLIC_MEDIA_BASE_URL=
# Optional second factor supported by Exotel's WebSocket client.
MEDIA_BASIC_USERNAME=
MEDIA_BASIC_PASSWORD=
HOST=127.0.0.1
PORT=8080
PREPARED_CALL_TTL_MS=60000

# Asterisk ARI stays on loopback. Zadarma is the primary PSTN carrier.
# Zadarma's IP-authorized trunk does not use a SIP password or REGISTER.
# ElevateBox only needs the Asterisk endpoint name. Leave CallerID blank to use
# Zadarma's default for the SIP connection.
ASTERISK_ARI_BASE_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=elevatebox
ASTERISK_ZADARMA_ENDPOINT=zadarma
ASTERISK_OPENAI_ENDPOINT=openai
ASTERISK_ARI_TIMEOUT_MS=8000
ASTERISK_ORIGINATE_TIMEOUT_SECONDS=30
ZADARMA_CALLER_ID=

# Exotel direct AgentStream outbound API, retained only for rollback.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
# Mumbai; use https://api.exotel.com only for Singapore-region accounts.
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_TIMEOUT_MS=8000
EXOTEL_TIME_LIMIT_SECONDS=600

# Primary WhatsApp provider: a separately deployed OpenWA REST gateway.
# Put the OpenWA API key here, never in source code or a committed file.
# Loopback HTTP is accepted locally; remote OpenWA endpoints must use HTTPS.
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_TIMEOUT_MS=8000

# Optional official Meta WhatsApp Cloud API fallback (WHATSAPP_PROVIDER=meta).
# Live mode sends one approved template containing exactly one positional body
# text parameter. Credentials are unused unless this provider is selected live.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Pin a Graph version supported by your Meta app instead of relying on latest.
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TIMEOUT_MS=8000

# Provider-neutral CRM/calendar/job-scheduler webhook. The exact JSON body is
# signed with HMAC-SHA256 and also carries Idempotency-Key.
CALLBACK_WEBHOOK_URL=
CALLBACK_WEBHOOK_SECRET=
CALLBACK_TIMEOUT_MS=8000
# Used only by CALLBACK_PROVIDER=automatic-sip. Keep this under a directory
# writable by the systemd service (the deployed trace directory is writable).
CALLBACK_STATE_PATH=logs/live-calls/scheduled-callbacks.json
CALLBACK_RECOVERY_GRACE_MS=900000
